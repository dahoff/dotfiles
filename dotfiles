#!/usr/bin/env bash
# dotfiles - Dotfiles orchestrator
# Usage: dotfiles <command> [--profile NAME] [options]

set -euo pipefail

# Get script directory
# Resolve the symlink chain (no readlink -f: macOS lacks it)
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
    _dir=$(cd -P "$(dirname "$_src")" && pwd)
    _src=$(readlink "$_src")
    [[ $_src != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR=$(cd -P "$(dirname "$_src")" && pwd)
unset _src _dir

# Source libraries
source "$SCRIPT_DIR/lib/logging.sh"
source "$SCRIPT_DIR/lib/yaml.sh"
source "$SCRIPT_DIR/lib/utils.sh"
source "$SCRIPT_DIR/lib/hosts.sh"
source "$SCRIPT_DIR/lib/overlay.sh"
source "$SCRIPT_DIR/lib/profile.sh"
source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/sync.sh"
source "$SCRIPT_DIR/lib/state.sh"
source "$SCRIPT_DIR/lib/push.sh"

# Configuration
PROFILES_DIR="$SCRIPT_DIR/profiles"

# Parsed package manifest (parallel arrays)
declare -a PKG_NAMES=()
declare -a PKG_APT=()
declare -a PKG_DNF=()
declare -a PKG_BREW=()
declare -a PKG_CUSTOM_CHECK=()
declare -a PKG_CUSTOM_SCRIPT=()
declare -a PKG_CUSTOM_DROPIN=()
declare -a PKG_CONFIG_DIR=()
declare -a PKG_CONFIG_FLAGS=()

# Command and flags
COMMAND=""
INSTALLER_CMD=""
PROFILE_ARG=""
HOSTS_REPO=""
HOSTNAME_ARG=""
DOTFILES_REPO=""
AUTO_SYNC="on"
AUTO_SYNC_SECONDS=14400
DEFAULT_HOSTS_REPO="$HOME/.local/share/dotfiles/dotfiles-hosts"

# Resolution results (set by load_packages_for_profile)
RESOLVED_PROFILE=""
declare -a HOSTS_PROFILE_CHAIN=()   # hosts-repo profiles in the chain, base-most first
HOST_YAML=""
OVERLAY_HOST=""

# Overlay staging (per run_all)
WORK_DIR=""
STAGE_ROOT=""
STRATEGIES_FILE=""
declare -a LAYER_ROOTS=()
declare -a GLOBAL_FLAGS=()

# Result tracking: "target|item|ok" or "target|item|FAIL"
declare -a RESULTS=()
declare -a PUSH_HOSTS=()
EXIT_CODE=0
SYNC_NO_PULL=false
SYNC_RECORD=false
CHECK_ONLY=false    # --auto: phases 1 and 2 only check, never install
# Packages still missing (names from the profile); apps whose state version changed
declare -a PENDING=()
declare -a UPDATED_APPS=()

# Cross-module: shell scripts drop-in directory
SHELL_SCRIPTS_DIR="$HOME/.bashrc.d"

# Run a shell command string locally
# Usage: run_on_target command
run_on_target() {
    eval "$@" 9>&-
}

# Detect package manager
detect_pkg_manager() {
    if run_on_target "command -v apt-get" &>/dev/null; then
        echo "apt"
    elif run_on_target "command -v dnf" &>/dev/null; then
        echo "dnf"
    elif run_on_target "command -v brew" &>/dev/null; then
        echo "brew"
    else
        log_error "No supported package manager found (tried: apt-get, dnf, brew)"
        return 1
    fi
}

# Check if a package is installed
is_pkg_installed() {
    local pkg="$1"
    local manager="$2"
    case "$manager" in
        apt)
            run_on_target "dpkg -l '$pkg' 2>/dev/null | grep -q '^ii'" && return 0
            run_on_target "command -v '$pkg'" &>/dev/null && return 0
            return 1
            ;;
        dnf)
            run_on_target "rpm -q '$pkg'" &>/dev/null && return 0
            run_on_target "command -v '$pkg'" &>/dev/null && return 0
            return 1
            ;;
        brew)
            run_on_target "brew list '$pkg'" &>/dev/null
            ;;
    esac
}

# Phase 1: Install all OS packages in one batch
run_phase_os_packages() {
    local target="local"
    local dry_run=false
    for flag in "${GLOBAL_FLAGS[@]}"; do
        [[ "$flag" == "--dry-run" ]] && dry_run=true
    done

    # Detect package manager
    local pkg_manager
    pkg_manager=$(detect_pkg_manager) || return 1
    log_info "[$target] Detected package manager: $pkg_manager"

    # Collect all OS packages for this manager
    local -a pkg_list=() pkg_names=()
    for idx in "${!PKG_NAMES[@]}"; do
        local pkg=""
        case "$pkg_manager" in
            apt) pkg="${PKG_APT[$idx]}" ;;
            dnf) pkg="${PKG_DNF[$idx]}" ;;
            brew) pkg="${PKG_BREW[$idx]}" ;;
        esac
        if [[ -n "$pkg" ]]; then
            pkg_list+=("$pkg")
            pkg_names+=("${PKG_NAMES[$idx]}")
        fi
    done

    if [[ ${#pkg_list[@]} -eq 0 ]]; then
        log_info "[$target] No OS packages to install"
        return 0
    fi

    # Filter to only missing packages 
    local -a missing=() missing_names=()
    local i
    for i in "${!pkg_list[@]}"; do
        pkg="${pkg_list[$i]}"
        if ! is_pkg_installed "$pkg" "$pkg_manager"; then
            missing+=("$pkg")
            missing_names+=("${pkg_names[$i]}")
        else
            log_debug "Already installed: $pkg"
        fi
    done

    if [[ ${#missing[@]} -eq 0 ]]; then
        log_success "[$target] All OS packages already installed"
        RESULTS+=("$target|os-packages|ok")
        return 0
    fi

    log_info "[$target] Packages to install: ${missing[*]}"

    # --auto never installs OS packages: report them as pending
    if [[ "$CHECK_ONLY" == true ]]; then
        log_info "[$target] Check only: ${#missing[@]} package(s) pending: ${missing_names[*]}"
        PENDING+=("${missing_names[@]}")
        return 0
    fi

    if [[ "$dry_run" == true ]]; then
        log_info "[$target] [DRY-RUN] Would install ${#missing[@]} package(s) via $pkg_manager"
        RESULTS+=("$target|os-packages|ok")
        return 0
    fi

    case "$pkg_manager" in
        apt)
            run_on_target "sudo apt-get update -qq && sudo apt-get install -y -qq ${missing[*]}"
            ;;
        dnf)
            run_on_target "sudo dnf install -y -q ${missing[*]}"
            ;;
        brew)
            run_on_target "brew install ${missing[*]}"
            ;;
    esac

    # Whatever is still missing after the install stays pending
    for i in "${!missing[@]}"; do
        is_pkg_installed "${missing[$i]}" "$pkg_manager" || PENDING+=("${missing_names[$i]}")
    done

    log_success "[$target] Installed ${#missing[@]} OS package(s)"
    RESULTS+=("$target|os-packages|ok")
    return 0
}

# Phase 2: Run custom installs
run_phase_custom_installs() {
    local target="local"
    local dry_run=false
    for flag in "${GLOBAL_FLAGS[@]}"; do
        [[ "$flag" == "--dry-run" ]] && dry_run=true
    done

    local has_custom=false
    for idx in "${!PKG_NAMES[@]}"; do
        local name="${PKG_NAMES[$idx]}"
        local check="${PKG_CUSTOM_CHECK[$idx]}"
        local script="${PKG_CUSTOM_SCRIPT[$idx]}"
        local dropin="${PKG_CUSTOM_DROPIN[$idx]}"

        [[ -z "$script" ]] && continue
        has_custom=true

        # Run install script if tool not already installed 
        if [[ -n "$check" ]] && run_on_target "$check" &>/dev/null; then
            log_info "[$target] $name: already installed"
        elif [[ "$CHECK_ONLY" == true ]]; then
            # --auto never runs install scripts. Without a check we cannot tell
            # whether the tool is missing, so it is not reported as pending.
            if [[ -n "$check" ]]; then
                log_info "[$target] $name: not installed (pending, install skipped)"
                PENDING+=("$name")
            else
                log_info "[$target] $name: no check defined, install skipped"
            fi
        elif [[ "$dry_run" == true ]]; then
            log_info "[$target] [DRY-RUN] Would run: $SCRIPT_DIR/packages/$script"
        else
            log_info "[$target] Running custom install: $name"

            local script_path="$SCRIPT_DIR/packages/$script"
            if [[ ! -x "$script_path" ]]; then
                log_error "Custom install script not found or not executable: $script_path"
                PENDING+=("$name")
                RESULTS+=("$target|$name|FAIL")
                EXIT_CODE=1
                continue
            fi

            if bash "$script_path" 9>&-; then
                log_success "[$target] Custom install complete: $name"
                if [[ -n "$check" ]] && ! run_on_target "$check" &>/dev/null; then
                    PENDING+=("$name")
                fi
            else
                log_error "[$target] Custom install failed: $name"
                PENDING+=("$name")
                RESULTS+=("$target|$name|FAIL")
                EXIT_CODE=1
                continue
            fi
        fi

        # Always install dropin (even if tool was already installed)
        if [[ -n "$dropin" ]]; then
            local dropin_src="$SCRIPT_DIR/packages/$dropin"
            local dropin_dest="$SHELL_SCRIPTS_DIR/$(basename "$dropin")"
            if [[ -f "$dropin_src" ]]; then
                if [[ "$dry_run" == true ]]; then
                    log_info "[$target] [DRY-RUN] Would install dropin: $dropin_dest"
                else
                    mkdir -p "$SHELL_SCRIPTS_DIR"
                    cp "$dropin_src" "$dropin_dest"
                    chmod 0644 "$dropin_dest"
                    log_debug "Installed dropin: $dropin_dest"
                fi
            fi
        fi
    done

    if [[ "$has_custom" == true ]]; then
        RESULTS+=("$target|custom-installs|ok")
    fi
    return 0
}

# Phase 3: Deploy configs via app installers
run_phase_configs() {
    local target="local"

    for idx in "${!PKG_NAMES[@]}"; do
        local name="${PKG_NAMES[$idx]}"
        local dir="${PKG_CONFIG_DIR[$idx]}"
        local flags="${PKG_CONFIG_FLAGS[$idx]}"

        [[ -z "$dir" ]] && continue

        local installer="$SCRIPT_DIR/$dir/install.sh"

        if [[ ! -f "$installer" ]]; then
            log_error "Installer not found: $installer"
            RESULTS+=("$target|$name|FAIL")
            EXIT_CODE=1
            continue
        fi

        # Compose this app's files from all layers
        local -a stage_args=()
        if [[ -f "$SCRIPT_DIR/$dir/config.yaml" ]]; then
            local stage="$STAGE_ROOT/apps/$dir"
            if ! overlay_stage_app "$SCRIPT_DIR/$dir" "$stage" "$STRATEGIES_FILE" "${LAYER_ROOTS[@]}"; then
                log_error "[$target] $name: could not stage files"
                RESULTS+=("$target|$name|FAIL")
                EXIT_CODE=1
                continue
            fi
            stage_args=(--stage "$stage")
        fi

        # Build command
        local cmd_args=("$INSTALLER_CMD")

        cmd_args+=("${stage_args[@]}")

        # Add per-package config flags
        if [[ -n "$flags" ]]; then
            # shellcheck disable=SC2206
            cmd_args+=($flags)
        fi

        # Add global flags
        cmd_args+=("${GLOBAL_FLAGS[@]}")

        log_info "[$target] $name: $INSTALLER_CMD"
        log_debug "Running: $installer ${cmd_args[*]}"

        export DOTFILES_FAILURES_FILE="$STAGE_ROOT/failures"
        : > "$DOTFILES_FAILURES_FILE"

        # State name is app.name from config.yaml (dir name as fallback)
        local app_name="" ver_before="" ver_after="" installed_ok=false
        if [[ -f "$SCRIPT_DIR/$dir/config.yaml" ]]; then
            yaml_load "$SCRIPT_DIR/$dir/config.yaml"
            app_name=$(yaml_get app.name)
        fi
        [[ -n "$app_name" ]] || app_name=$(basename "$dir")
        ver_before=$(state_get_version "$app_name" 2>/dev/null || true)

        if bash "$installer" "${cmd_args[@]}" 9>&-; then
            installed_ok=true
            RESULTS+=("$target|$name|ok")
        else
            log_error "[$target] $name: $INSTALLER_CMD failed"
            RESULTS+=("$target|$name|FAIL")
            EXIT_CODE=1
        fi

        # Updated = installer succeeded and the version changed (a new state file
        # has an empty "before"). A failed run or "incomplete" is not an update.
        ver_after=$(state_get_version "$app_name" 2>/dev/null || true)
        if [[ "$installed_ok" == true && "$ver_after" != "incomplete" \
            && "$ver_after" != "$ver_before" ]]; then
            UPDATED_APPS+=("$name")
        fi

        # Per-file failures reported by the installer
        local failed
        while IFS= read -r failed; do
            [[ -n "$failed" ]] && RESULTS+=("$target|$failed|FAIL")
        done < "$DOTFILES_FAILURES_FILE"
    done
}

# Run all phases locally
# Usage: run_all PROFILE_ARG
run_all() {
    local profile="${1:-}"
    local target="local"

    if [[ -n "$HOSTNAME_ARG" ]]; then
        OVERLAY_HOST="$HOSTNAME_ARG"
    else
        OVERLAY_HOST=$(hosts_local_name)
    fi

    # Load profile-specific package list
    # A validation failure aborts run_all; record it first so the report names it
    if ! load_packages_for_profile "$profile" "$OVERLAY_HOST"; then
        RESULTS+=("$target|profile|FAIL")
        EXIT_CODE=1
        return 1
    fi
    log_info "[$target] Using profile '$RESOLVED_PROFILE' (${#PKG_NAMES[@]} package(s))"
    if [[ -n "$HOST_YAML" ]]; then
        log_info "[$target] Host directory: hosts/$OVERLAY_HOST"
    fi
    log_info "[$target] Packages: ${PKG_NAMES[*]}"

    # Validate overlays before any change
    if ! prepare_overlays "$target"; then
        log_error "[$target] Invalid overlay configuration; no changes made"
        RESULTS+=("$target|overlays|FAIL")
        EXIT_CODE=1
        return 1
    fi

    # Phase 1: OS packages (batch install)
    log_info "[$target] Phase 1: OS packages"
    run_phase_os_packages || true

    # Phase 2: Custom installs
    log_info "[$target] Phase 2: Custom installs"
    run_phase_custom_installs || true

    # Phase 3: Config deployments
    log_info "[$target] Phase 3: Config deployments"
    run_phase_configs
}

# Print summary report
print_summary() {
    echo
    echo "======================================"
    echo "Setup Summary"
    echo "======================================"
    echo

    local total=0
    local passed=0
    local failed=0

    for result in "${RESULTS[@]}"; do
        total=$((total + 1))
        local target item status
        IFS='|' read -r target item status <<< "$result"

        if [[ "$status" == "ok" ]]; then
            passed=$((passed + 1))
            log_success "[$target] $item: $INSTALLER_CMD"
        else
            failed=$((failed + 1))
            log_error "[$target] $item: $INSTALLER_CMD FAILED"
        fi
    done

    echo
    echo "Total: $total  Passed: $passed  Failed: $failed"

    if [[ ${#SYNC_WARNINGS[@]} -gt 0 ]]; then
        echo
        echo "Warnings:"
        local w
        for w in "${SYNC_WARNINGS[@]}"; do
            log_warn "$w"
        done
    fi

    if [[ $failed -eq 0 ]]; then
        log_success "All operations completed successfully!"
    else
        log_error "$failed operation(s) failed"
    fi
}

# Show usage
usage() {
    cat << 'EOF'
Usage: dotfiles <command> [options]

Commands:
  sync                 Pull, then install if new, upgrade if exists (idempotent)
  push HOST...         Copy committed repo snapshots to HOST over ssh and sync there
  uninstall            Uninstall all configs
  status               Show repos, host, last sync, pending packages and app state (read-only)
  verify               Verify all installations
  help                 Show this help message

Profile options:
  --profile NAME       Use a specific profile (default: complete)
                       Profiles are defined in profiles/<name>.yaml

Hosts repo options:
  --hosts-repo PATH    dotfiles-hosts checkout (default: env DOTFILES_HOSTS_REPO)
                       Profiles are looked up there first, then in profiles/
  --hostname NAME      Host directory hosts/NAME/ to apply (default: hostname -s)

Sync options:
  --auto               Background mode (used by the login drop-in)
  --no-pull            Do not git pull the dotfiles and hosts repos

Options (passed through to each app's installer):
  --dry-run            Show what would be done without making changes
  --no-backup          Skip creating backups
  --verbose            Verbose output
  --quiet              Minimal output
  --force              Force operation without prompts
  --skip-git-setup     Skip interactive git identity setup (for unattended runs)
  --shell-scripts-dir PATH  Set drop-in directory (default: ~/.bashrc.d)
  --log FILE           Log to file

Examples:
  dotfiles sync                      # Sync (uses profiles/complete.yaml)
  dotfiles sync --profile minimal    # Sync with the minimal profile
  dotfiles sync --dry-run            # Preview what would happen
  dotfiles push user@host            # Ship the repos to a host without git, sync there
  dotfiles status                    # Check all configs
  dotfiles uninstall --no-backup     # Remove all configs

EOF
}

# Validate command
validate_command() {
    local cmd="$1"

    cmd=$(echo "$cmd" | tr -cd '[:alnum:]-')

    local valid_commands=(
        "sync"
        "push"
        "uninstall"
        "status"
        "verify"
        "help"
        "-h"
        "--help"
    )

    for valid_cmd in "${valid_commands[@]}"; do
        if [[ "$cmd" == "$valid_cmd" ]]; then
            echo "$cmd"
            return 0
        fi
    done

    echo "Error: Unknown command '$1'" >&2
    echo "" >&2
    echo "Valid commands: sync, push, uninstall, status, verify, help" >&2
    return 1
}

# Parse arguments
parse_args() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 1
    fi

    COMMAND=$(validate_command "$1") || exit 1
    shift

    case "$COMMAND" in
        sync) INSTALLER_CMD="deploy" ;;
        *) INSTALLER_CMD="$COMMAND" ;;
    esac

    while [[ $# -gt 0 ]]; do
        case $1 in
            --profile)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --profile requires a profile name" >&2
                    exit 1
                fi
                PROFILE_ARG="$2"
                shift 2
                ;;
            --hosts-repo)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --hosts-repo requires a path argument" >&2
                    exit 1
                fi
                HOSTS_REPO="$2"
                shift 2
                ;;
            --hostname)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --hostname requires a name argument" >&2
                    exit 1
                fi
                if [[ -z "$2" || "$2" == */* || "$2" == . || "$2" == .. ]]; then
                    echo "Error: invalid --hostname '$2' (must be a plain name without '/')" >&2
                    exit 1
                fi
                HOSTNAME_ARG="$2"
                shift 2
                ;;
            --auto)
                SYNC_AUTO=true
                CHECK_ONLY=true
                shift
                ;;
            --no-pull)
                SYNC_NO_PULL=true
                shift
                ;;
            --dry-run|--no-backup|--verbose|--quiet|--force)
                GLOBAL_FLAGS+=("$1")
                shift
                ;;
            --skip-git-setup)
                export GIT_SETUP_SKIP=true
                shift
                ;;
            --shell-scripts-dir)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --shell-scripts-dir requires a path argument" >&2
                    exit 1
                fi
                SHELL_SCRIPTS_DIR="$2"
                GLOBAL_FLAGS+=("$1" "$2")
                shift 2
                ;;
            --log)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --log requires a filename argument" >&2
                    exit 1
                fi
                GLOBAL_FLAGS+=("$1" "$2")
                shift 2
                ;;
            *)
                if [[ "$COMMAND" == "push" && "$1" != -* ]]; then
                    PUSH_HOSTS+=("$1")
                    shift
                    continue
                fi
                echo "Error: Unknown option: $1" >&2
                usage
                exit 1
                ;;
        esac
    done
}

# Fill in settings from flags, env, the config file and defaults.
# Precedence: flag > env DOTFILES_HOSTS_REPO (hosts repo only) > config > default.
# parse_args has set PROFILE_ARG/HOSTS_REPO/HOSTNAME_ARG only from flags.
resolve_settings() {
    local config_file="${DOTFILES_CONFIG:-$HOME/.config/dotfiles/config}"
    config_load "$config_file" || return 1

    # The running code is always the repo it was started from
    DOTFILES_REPO="$SCRIPT_DIR"
    if [[ -n "$CFG_DOTFILES_REPO" ]]; then
        if [[ ! -d "$CFG_DOTFILES_REPO" ]]; then
            log_error "dotfiles repo not found: $CFG_DOTFILES_REPO"
            return 1
        fi
        if [[ "$(cd "$CFG_DOTFILES_REPO" && pwd -P)" != "$(cd "$SCRIPT_DIR" && pwd -P)" ]]; then
            log_warn "Running $SCRIPT_DIR/dotfiles but config dotfiles_repo is $CFG_DOTFILES_REPO"
        fi
    fi

    if [[ -z "$HOSTS_REPO" ]]; then
        if [[ -n "${DOTFILES_HOSTS_REPO:-}" ]]; then
            HOSTS_REPO="$DOTFILES_HOSTS_REPO"
        elif [[ -n "$CFG_HOSTS_REPO" ]]; then
            HOSTS_REPO="$CFG_HOSTS_REPO"
        elif [[ -d "$DEFAULT_HOSTS_REPO" ]]; then
            HOSTS_REPO="$DEFAULT_HOSTS_REPO"
        fi
    fi
    [[ -n "$HOSTNAME_ARG" ]] || HOSTNAME_ARG="$CFG_HOSTNAME"
    [[ -n "$PROFILE_ARG" ]] || PROFILE_ARG="$CFG_PROFILE"

    AUTO_SYNC="$CFG_AUTO_SYNC"
    AUTO_SYNC_SECONDS=$(config_interval_seconds "$CFG_AUTO_SYNC_INTERVAL")
}

# True if --dry-run was given
is_dry_run() {
    local flag
    for flag in "${GLOBAL_FLAGS[@]}"; do
        [[ "$flag" == "--dry-run" ]] && return 0
    done
    return 1
}

# EXIT trap: remove the work dir and run registered cleanup commands
cleanup() {
    local status=$?
    local cmd
    for cmd in "${SYNC_CLEANUP[@]}"; do
        eval "$cmd" || true
    done
    [[ -n "$WORK_DIR" ]] && rm -rf "$WORK_DIR"
    if [[ "$SYNC_RECORD" == true ]]; then
        # An abort outside run_all leaves no FAIL item: add one so --auto does
        # not fail silently. The pending file is left as it was (not refreshed).
        if [[ $status -ne 0 ]] && ! printf '%s\n' "${RESULTS[@]}" | grep -q '|FAIL$'; then
            RESULTS+=("local|setup|FAIL")
        fi
        sync_record
    fi
    return 0
}

# End of a real (non-dry-run) sync: record the run, clear a stale report
sync_record() {
    sync_touch_last
    if [[ "$SYNC_AUTO" == true ]]; then
        sync_write_report "$(sync_state_dir)/last-sync.log" \
            "$(IFS=,; echo "${UPDATED_APPS[*]}")" "$(IFS=,; echo "${PENDING[*]}")"
    else
        sync_clear_report
    fi
    return 0
}

# Pull one repo; a failure is a warning, not a sync failure
sync_pull_one() {
    local path="$1" reason
    if ! reason=$(sync_pull_repo "$path"); then
        SYNC_WARNINGS+=("$path: pull failed ($reason)")
        log_warn "$path: pull failed ($reason)"
    fi
}

# Describe a repo for status: git branch/sha/dirty, a pushed copy, or neither
# Usage: status_describe_repo PATH
status_describe_repo() {
    local path="$1" top branch sha dirty=""
    top=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)
    if [[ -n "$top" && "$(cd "$top" && pwd -P)" == "$(cd "$path" && pwd -P)" ]]; then
        branch=$(git -C "$path" symbolic-ref --short -q HEAD 2>/dev/null || echo "detached")
        sha=$(git -C "$path" rev-parse --short HEAD 2>/dev/null || echo "no commits")
        [[ -z "$(git --no-optional-locks -C "$path" status --porcelain 2>/dev/null)" ]] || dirty=", dirty"
        printf '%s  (git %s @ %s%s)' "$path" "$branch" "$sha" "$dirty"
    elif [[ -f "$path/PUSHED" ]]; then
        printf '%s  (pushed: %s)' "$path" "$(head -n1 "$path/PUSHED")"
    else
        printf '%s  (not a git checkout)' "$path"
    fi
}

# Seconds as "just now", "<n>m ago", "<n>h ago" or "<n>d ago" (rounded down)
status_age() {
    local s="$1"
    if (( s < 60 )); then printf 'just now'
    elif (( s < 3600 )); then printf '%dm ago' $((s / 60))
    elif (( s < 86400 )); then printf '%dh ago' $((s / 3600))
    else printf '%dd ago' $((s / 86400))
    fi
}

# dotfiles status: read-only summary. Takes no lock, never pulls, installs or
# writes state (SYNC_RECORD stays false). Resolution errors are printed and
# the command still exits 0.
cmd_status() {
    local config_file="${DOTFILES_CONFIG:-$HOME/.config/dotfiles/config}"
    # Not sync_state_dir: that creates the directory
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
    local ok=true

    resolve_settings || ok=false

    printf '%-17s%s\n' "dotfiles repo:" "$(status_describe_repo "$SCRIPT_DIR")"
    if [[ -z "$HOSTS_REPO" ]]; then
        printf '%-17s%s\n' "hosts repo:" "none"
    elif [[ -d "$HOSTS_REPO" ]]; then
        HOSTS_REPO="$(cd "$HOSTS_REPO" && pwd)"
        printf '%-17s%s\n' "hosts repo:" "$(status_describe_repo "$HOSTS_REPO")"
    else
        printf '%-17s%s\n' "hosts repo:" "$HOSTS_REPO  (not found)"
        log_error "Hosts repo not found or not a directory: $HOSTS_REPO"
        ok=false
    fi
    if [[ -f "$config_file" ]]; then
        printf '%-17s%s\n' "config:" "$config_file"
    else
        printf '%-17s%s\n' "config:" "$config_file (not found, using defaults)"
    fi

    # Host and profile
    local host host_note="(no host directory)" profile_note=""
    host="${HOSTNAME_ARG:-$(hosts_local_name)}"
    [[ -n "$HOSTS_REPO" && -f "$HOSTS_REPO/hosts/$host/host.yaml" ]] && host_note="(hosts/$host/host.yaml)"
    if [[ "$ok" == true ]]; then
        if load_packages_for_profile "$PROFILE_ARG" "$host"; then
            profile_note="   profile: $RESOLVED_PROFILE"
        else
            ok=false
        fi
    fi
    printf '%-17s%s\n' "host:" "$host  $host_note$profile_note"

    # Auto sync
    local auto_line="off" last now
    if [[ "$AUTO_SYNC" != "off" ]]; then
        auto_line="on, every ${CFG_AUTO_SYNC_INTERVAL:-4h}"
        if [[ -e "$state_dir/last-sync" ]] && last=$(sync_mtime "$state_dir/last-sync"); then
            now=$(date +%s)
            auto_line+=" — last run $(status_age $(( now > last ? now - last : 0 )))"
        else
            auto_line+=" — never run"
        fi
    fi
    printf '%-17s%s\n' "auto sync:" "$auto_line"

    # Pending packages
    local pending=""
    if [[ -f "$state_dir/pending" ]]; then
        pending=$(grep -v '^$' "$state_dir/pending" | paste -sd, - | sed 's/,/, /g' || true)
    fi
    printf '%-17s%s\n' "pending:" "${pending:-none}"

    # Apps: installed state version against a fresh stage
    if [[ "$ok" == true ]]; then
        OVERLAY_HOST="$host"
        if ! prepare_overlays "status"; then
            log_error "Invalid overlay configuration"
            ok=false
        fi
    fi
    if [[ "$ok" == true ]]; then
        echo "apps:"
        local idx dir name app_name stage ver_fresh ver_state state_file state
        for idx in "${!PKG_NAMES[@]}"; do
            dir="${PKG_CONFIG_DIR[$idx]}"
            [[ -n "$dir" && -f "$SCRIPT_DIR/$dir/config.yaml" ]] || continue
            name="${PKG_NAMES[$idx]}"
            yaml_load "$SCRIPT_DIR/$dir/config.yaml"
            app_name=$(yaml_get app.name)
            [[ -n "$app_name" ]] || app_name=$(basename "$dir")
            stage="$STAGE_ROOT/apps/$dir"
            ver_fresh=""
            if overlay_stage_app "$SCRIPT_DIR/$dir" "$stage" "$STRATEGIES_FILE" "${LAYER_ROOTS[@]}" 2>/dev/null; then
                ver_fresh=$(cat "$stage/version" 2>/dev/null || true)
            fi
            state_file=$(state_get_file "$app_name")
            if [[ ! -f "$state_file" ]]; then
                state="not installed"
            else
                ver_state=$(state_get_version "$app_name" 2>/dev/null || true)
                if [[ -n "$ver_fresh" && "$ver_state" == "$ver_fresh" && "$ver_state" != "incomplete" ]]; then
                    state="up to date"
                else
                    state="update available"
                fi
            fi
            printf '  %-9s %s\n' "$name" "$state"
        done
    fi
    return 0
}

# dotfiles push HOST...: no local sync, no lock, no local state
cmd_push() {
    if [[ ${#PUSH_HOSTS[@]} -eq 0 ]]; then
        echo "Usage: dotfiles push [--dry-run] HOST..." >&2
        exit 1
    fi
    local dry=false host failed=0
    is_dry_run && dry=true
    for host in "${PUSH_HOSTS[@]}"; do
        log_info "[$host] Pushing"
        if push_host "$host" false "$dry"; then
            RESULTS+=("$host|push|ok")
        else
            RESULTS+=("$host|push|FAIL")
            failed=1
        fi
    done
    print_summary
    exit $failed
}

# Main
main() {
    parse_args "$@"

    # Initialize logging
    log_init "$@"

    WORK_DIR=$(mktemp -d)
    trap cleanup EXIT

    # Handle help
    if [[ "$COMMAND" == "help" || "$COMMAND" == "--help" || "$COMMAND" == "-h" ]]; then
        usage
        exit 0
    fi

    if [[ "$COMMAND" == "status" ]]; then
        cmd_status
        exit 0
    fi

    if ! resolve_settings; then
        if [[ "$COMMAND" == "sync" && "$SYNC_AUTO" == true ]] && ! is_dry_run; then
            # A config error must not silence the background sync: report it.
            # The config is unusable, so the default throttle (4h) applies.
            sync_lock || exit 0
            AUTO_SYNC=on
            AUTO_SYNC_SECONDS=14400
            sync_should_run_auto || exit 0
            exec >"$(sync_state_dir)/last-sync.log" 2>&1
            echo "dotfiles sync --auto $(date +%Y-%m-%dT%H:%M:%S%z)"
            resolve_settings || true
            RESULTS+=("local|config|FAIL")
            SYNC_RECORD=true
        fi
        exit 1
    fi

    if [[ "$COMMAND" == "sync" ]] && ! is_dry_run; then
        if ! sync_lock; then
            [[ "$SYNC_AUTO" == true ]] && exit 0
            echo "dotfiles: sync already running" >&2
            exit 1
        fi
        if [[ "$SYNC_AUTO" == true ]]; then
            # Throttled or disabled: exit before recording is armed, so
            # last-sync, the report and the log stay untouched
            sync_should_run_auto || exit 0
            local log
            log="$(sync_state_dir)/last-sync.log"
            exec >"$log" 2>&1
            echo "dotfiles sync --auto $(date +%Y-%m-%dT%H:%M:%S%z)"
            export GIT_SETUP_SKIP=true
        fi
        # From here on the EXIT trap records the run, however it ends
        SYNC_RECORD=true
    fi

    # Validate hosts repo before any changes
    if [[ -n "$HOSTS_REPO" ]]; then
        if [[ ! -d "$HOSTS_REPO" ]]; then
            log_error "Hosts repo not found or not a directory: $HOSTS_REPO"
            exit 1
        fi
        HOSTS_REPO="$(cd "$HOSTS_REPO" && pwd)"
    fi

    [[ "$COMMAND" != "push" ]] || cmd_push

    if [[ "$COMMAND" == "sync" ]]; then
        if [[ "$SYNC_NO_PULL" != true ]] && ! is_dry_run; then
            sync_pull_one "$DOTFILES_REPO"
            [[ -z "$HOSTS_REPO" ]] || sync_pull_one "$HOSTS_REPO"
        fi
        # Link to the configured repo (not whichever checkout ran last); fall
        # back to the running checkout when none is configured
        local install_repo="$DOTFILES_REPO"
        if [[ -n "$CFG_DOTFILES_REPO" && -x "$CFG_DOTFILES_REPO/dotfiles" ]]; then
            install_repo="$CFG_DOTFILES_REPO"
        fi
        is_dry_run || sync_self_install "$install_repo" "$SHELL_SCRIPTS_DIR"
    fi

    run_all "$PROFILE_ARG"

    is_dry_run || sync_write_pending "${PENDING[@]}"

    print_summary

    exit $EXIT_CODE
}

main "$@"
