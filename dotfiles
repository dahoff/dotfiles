#!/usr/bin/env bash
# dotfiles - Dotfiles orchestrator
# Usage: dotfiles <command> [--profile NAME] [options]

set -euo pipefail

# Get script directory
# Resolve the symlink chain (no readlink -f: macOS lacks it)
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
    _dir=$(cd -P "$(dirname "$_src")" && pwd)
    _src=$(readlink "$_src")
    [[ $_src != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR=$(cd -P "$(dirname "$_src")" && pwd)
unset _src _dir

# Source libraries
source "$SCRIPT_DIR/lib/logging.sh"
source "$SCRIPT_DIR/lib/yaml.sh"
source "$SCRIPT_DIR/lib/utils.sh"
source "$SCRIPT_DIR/lib/hosts.sh"
source "$SCRIPT_DIR/lib/overlay.sh"
source "$SCRIPT_DIR/lib/profile.sh"
source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/sync.sh"
source "$SCRIPT_DIR/lib/state.sh"
source "$SCRIPT_DIR/lib/deployed.sh"
source "$SCRIPT_DIR/lib/versions.sh"
source "$SCRIPT_DIR/lib/add.sh"
source "$SCRIPT_DIR/lib/push.sh"
source "$SCRIPT_DIR/lib/init.sh"

# Configuration
PROFILES_DIR="$SCRIPT_DIR/profiles"
APPS_DIR="$SCRIPT_DIR/apps"

# Parsed package manifest (parallel arrays)
declare -a PKG_NAMES=()
declare -a PKG_APT=()
declare -a PKG_DNF=()
declare -a PKG_BREW=()
declare -a PKG_CUSTOM_CHECK=()
declare -a PKG_CUSTOM_SCRIPT=()
declare -a PKG_CUSTOM_DROPIN=()
declare -a PKG_CONFIG_DIR=()
declare -a PKG_CONFIG_FLAGS=()

# Command and flags
COMMAND=""
INSTALLER_CMD=""
PROFILE_ARG=""
HOSTS_DIR=""
# Export of the hosts repo's HEAD that profiles and layers are read from (see use_committed_trees)
HOSTS_TREE=""
HOSTNAME_ARG=""
DOTFILES_REPO=""
UPDATE_CHECK="on"
UPDATE_CHECK_SECONDS=14400
DEFAULT_HOSTS_DIR="$HOME/.local/share/dotfiles/dotfiles-hosts"

# Resolution results (set by load_packages_for_profile)
RESOLVED_PROFILE=""
declare -a HOSTS_PROFILE_CHAIN=()   # hosts-dir profiles in the chain, base-most first
HOST_YAML=""
OVERLAY_HOST=""

# Overlay staging (per run_all)
WORK_DIR=""
STAGE_ROOT=""
STRATEGIES_FILE=""
declare -a LAYER_ROOTS=()
declare -a GLOBAL_FLAGS=()

# Result tracking: "target|item|ok" or "target|item|FAIL"
declare -a RESULTS=()
declare -a PUSH_HOSTS=()
CHECKOUT_REF=""
declare -a INIT_ARGS=()
# init --remote: run the remote 'dotfiles init' with PUSH_INIT_ARGS
PUSH_INIT=false
declare -a PUSH_INIT_ARGS=()
EXIT_CODE=0
SYNC_NO_FETCH=false
SYNC_RECORD=false
# Packages still missing (names from the profile)
declare -a PENDING=()

# Cross-module: shell scripts drop-in directory
SHELL_SCRIPTS_DIR="$HOME/.bashrc.d"

# Run a shell command string locally
# Usage: run_on_target command
run_on_target() {
    eval "$@" 9>&-
}

# Detect package manager
detect_pkg_manager() {
    if run_on_target "command -v apt-get" &>/dev/null; then
        echo "apt"
    elif run_on_target "command -v dnf" &>/dev/null; then
        echo "dnf"
    elif run_on_target "command -v brew" &>/dev/null; then
        echo "brew"
    else
        log_error "No supported package manager found (tried: apt-get, dnf, brew)"
        return 1
    fi
}

# Check if a package is installed
is_pkg_installed() {
    local pkg="$1"
    local manager="$2"
    case "$manager" in
        apt)
            run_on_target "dpkg -l '$pkg' 2>/dev/null | grep -q '^ii'" && return 0
            run_on_target "command -v '$pkg'" &>/dev/null && return 0
            return 1
            ;;
        dnf)
            run_on_target "rpm -q '$pkg'" &>/dev/null && return 0
            run_on_target "command -v '$pkg'" &>/dev/null && return 0
            return 1
            ;;
        brew)
            run_on_target "brew list '$pkg'" &>/dev/null
            ;;
    esac
}

# Phase 1: Install all OS packages in one batch
run_phase_os_packages() {
    local target="local"
    local dry_run=false
    for flag in "${GLOBAL_FLAGS[@]}"; do
        [[ "$flag" == "--dry-run" ]] && dry_run=true
    done

    # Detect package manager
    local pkg_manager
    pkg_manager=$(detect_pkg_manager) || return 1
    log_info "[$target] Detected package manager: $pkg_manager"

    # Collect all OS packages for this manager
    local -a pkg_list=() pkg_names=()
    for idx in "${!PKG_NAMES[@]}"; do
        local pkg=""
        case "$pkg_manager" in
            apt) pkg="${PKG_APT[$idx]}" ;;
            dnf) pkg="${PKG_DNF[$idx]}" ;;
            brew) pkg="${PKG_BREW[$idx]}" ;;
        esac
        if [[ -n "$pkg" ]]; then
            pkg_list+=("$pkg")
            pkg_names+=("${PKG_NAMES[$idx]}")
        fi
    done

    if [[ ${#pkg_list[@]} -eq 0 ]]; then
        log_info "[$target] No OS packages to install"
        return 0
    fi

    # Filter to only missing packages 
    local -a missing=() missing_names=()
    local i
    for i in "${!pkg_list[@]}"; do
        pkg="${pkg_list[$i]}"
        if ! is_pkg_installed "$pkg" "$pkg_manager"; then
            missing+=("$pkg")
            missing_names+=("${pkg_names[$i]}")
        else
            log_debug "Already installed: $pkg"
        fi
    done

    if [[ ${#missing[@]} -eq 0 ]]; then
        log_success "[$target] All OS packages already installed"
        RESULTS+=("$target|os-packages|ok")
        return 0
    fi

    log_info "[$target] Packages to install: ${missing[*]}"

    if [[ "$dry_run" == true ]]; then
        log_info "[$target] [DRY-RUN] Would install ${#missing[@]} package(s) via $pkg_manager"
        RESULTS+=("$target|os-packages|ok")
        return 0
    fi

    case "$pkg_manager" in
        apt)
            run_on_target "sudo apt-get update -qq && sudo apt-get install -y -qq ${missing[*]}"
            ;;
        dnf)
            run_on_target "sudo dnf install -y -q ${missing[*]}"
            ;;
        brew)
            run_on_target "brew install ${missing[*]}"
            ;;
    esac

    # Whatever is still missing after the install stays pending
    for i in "${!missing[@]}"; do
        is_pkg_installed "${missing[$i]}" "$pkg_manager" || PENDING+=("${missing_names[$i]}")
    done

    log_success "[$target] Installed ${#missing[@]} OS package(s)"
    RESULTS+=("$target|os-packages|ok")
    return 0
}

# Phase 2: Run custom installs
run_phase_custom_installs() {
    local target="local"
    local dry_run=false
    for flag in "${GLOBAL_FLAGS[@]}"; do
        [[ "$flag" == "--dry-run" ]] && dry_run=true
    done

    local has_custom=false
    for idx in "${!PKG_NAMES[@]}"; do
        local name="${PKG_NAMES[$idx]}"
        local check="${PKG_CUSTOM_CHECK[$idx]}"
        local script="${PKG_CUSTOM_SCRIPT[$idx]}"
        local dropin="${PKG_CUSTOM_DROPIN[$idx]}"

        [[ -z "$script" ]] && continue
        has_custom=true

        # Run install script if tool not already installed 
        if [[ -n "$check" ]] && run_on_target "$check" &>/dev/null; then
            log_info "[$target] $name: already installed"
        elif [[ "$dry_run" == true ]]; then
            log_info "[$target] [DRY-RUN] Would run: $APPS_DIR/$script"
        else
            log_info "[$target] Running custom install: $name"

            local script_path="$APPS_DIR/$script"
            if [[ ! -x "$script_path" ]]; then
                log_error "Custom install script not found or not executable: $script_path"
                PENDING+=("$name")
                RESULTS+=("$target|$name|FAIL")
                EXIT_CODE=1
                continue
            fi

            if bash "$script_path" 9>&-; then
                log_success "[$target] Custom install complete: $name"
                if [[ -n "$check" ]] && ! run_on_target "$check" &>/dev/null; then
                    PENDING+=("$name")
                fi
            else
                log_error "[$target] Custom install failed: $name"
                PENDING+=("$name")
                RESULTS+=("$target|$name|FAIL")
                EXIT_CODE=1
                continue
            fi
        fi

        # Deploy the dropin only when the tool is there: no check, or the check
        # passes after the install step. An existing copy is never removed.
        if [[ -n "$dropin" && -n "$check" ]] && ! run_on_target "$check" &>/dev/null; then
            log_info "[$target] $name: drop-in held until the tool is installed"
        elif [[ -n "$dropin" ]]; then
            local dropin_src="$APPS_DIR/$dropin"
            local dropin_dest="$SHELL_SCRIPTS_DIR/$(basename "$dropin")"
            if [[ -f "$dropin_src" ]]; then
                if [[ "$dry_run" == true ]]; then
                    log_info "[$target] [DRY-RUN] Would install dropin: $dropin_dest"
                else
                    mkdir -p "$SHELL_SCRIPTS_DIR"
                    cp "$dropin_src" "$dropin_dest"
                    chmod 0644 "$dropin_dest"
                    log_debug "Installed dropin: $dropin_dest"
                fi
            fi
        fi
    done

    if [[ "$has_custom" == true ]]; then
        RESULTS+=("$target|custom-installs|ok")
    fi
    return 0
}

# Phase 3: Deploy configs via app installers
run_phase_configs() {
    local target="local"

    for idx in "${!PKG_NAMES[@]}"; do
        local name="${PKG_NAMES[$idx]}"
        local dir="${PKG_CONFIG_DIR[$idx]}"
        local flags="${PKG_CONFIG_FLAGS[$idx]}"

        [[ -z "$dir" ]] && continue

        local installer="$APPS_DIR/$dir/configure.sh"

        if [[ ! -f "$installer" ]]; then
            log_error "Installer not found: $installer"
            RESULTS+=("$target|$name|FAIL")
            EXIT_CODE=1
            continue
        fi

        # Compose this app's files from all layers
        local -a stage_args=()
        if [[ -f "$APPS_DIR/$dir/config.yaml" ]]; then
            local stage="$STAGE_ROOT/apps/$dir"
            if ! overlay_stage_app "$APPS_DIR/$dir" "$stage" "$STRATEGIES_FILE" "${LAYER_ROOTS[@]}"; then
                log_error "[$target] $name: could not stage files"
                RESULTS+=("$target|$name|FAIL")
                EXIT_CODE=1
                continue
            fi
            stage_args=(--stage "$stage")
        fi

        # Build command
        local cmd_args=("$INSTALLER_CMD")

        cmd_args+=("${stage_args[@]}")

        # Add per-package config flags
        if [[ -n "$flags" ]]; then
            # shellcheck disable=SC2206
            cmd_args+=($flags)
        fi

        # Add global flags
        cmd_args+=("${GLOBAL_FLAGS[@]}")

        log_info "[$target] $name: $INSTALLER_CMD"
        log_debug "Running: $installer ${cmd_args[*]}"

        export DOTFILES_FAILURES_FILE="$STAGE_ROOT/failures"
        : > "$DOTFILES_FAILURES_FILE"
        export DOTFILES_KEPT_FILE="$STAGE_ROOT/kept"
        : > "$DOTFILES_KEPT_FILE"
        export DOTFILES_WARNINGS_FILE="$STAGE_ROOT/warnings"
        : > "$DOTFILES_WARNINGS_FILE"

        if bash "$installer" "${cmd_args[@]}" 9>&-; then
            RESULTS+=("$target|$name|ok")
        else
            log_error "[$target] $name: $INSTALLER_CMD failed"
            RESULTS+=("$target|$name|FAIL")
            EXIT_CODE=1
        fi

        # Per-file failures reported by the installer
        local failed
        while IFS= read -r failed; do
            [[ -n "$failed" ]] && RESULTS+=("$target|$failed|FAIL")
        done < "$DOTFILES_FAILURES_FILE"

        # Edits kept although the repo changed the same file: shown in the summary
        local kept
        while IFS= read -r kept; do
            [[ -n "$kept" ]] && SYNC_WARNINGS+=("kept your edit to $kept, the repo changed it too (run 'dotfiles add')")
        done < "$DOTFILES_KEPT_FILE"
        local warning
        while IFS= read -r warning; do
            [[ -n "$warning" ]] && SYNC_WARNINGS+=("$warning")
        done < "$DOTFILES_WARNINGS_FILE"
    done
}

# Run all phases locally
# Usage: run_all PROFILE_ARG
run_all() {
    local profile="${1:-}"
    local target="local"

    if [[ -n "$HOSTNAME_ARG" ]]; then
        OVERLAY_HOST="$HOSTNAME_ARG"
    else
        OVERLAY_HOST=$(hosts_local_name)
    fi

    # Load profile-specific package list
    # A validation failure aborts run_all; record it first so the report names it
    if ! load_packages_for_profile "$profile" "$OVERLAY_HOST"; then
        RESULTS+=("$target|profile|FAIL")
        EXIT_CODE=1
        return 1
    fi
    log_info "[$target] Using profile '$RESOLVED_PROFILE' (${#PKG_NAMES[@]} package(s))"
    if [[ -n "$HOST_YAML" ]]; then
        log_info "[$target] Host directory: hosts/$OVERLAY_HOST"
    fi
    log_info "[$target] Packages: ${PKG_NAMES[*]}"

    # Validate overlays before any change
    if ! prepare_overlays "$target"; then
        log_error "[$target] Invalid overlay configuration; no changes made"
        RESULTS+=("$target|overlays|FAIL")
        EXIT_CODE=1
        return 1
    fi

    # Only pull installs tools; uninstall and verify act on configs alone
    if [[ "$COMMAND" == "pull" ]]; then
        # Phase 1: OS packages (batch install)
        log_info "[$target] Phase 1: OS packages"
        run_phase_os_packages || true

        # Phase 2: Custom installs
        log_info "[$target] Phase 2: Custom installs"
        run_phase_custom_installs || true
    fi

    # Phase 3: Config deployments
    log_info "[$target] Phase 3: Config deployments"
    run_phase_configs
}

# Print summary report
print_summary() {
    echo
    echo "======================================"
    echo "Setup Summary"
    echo "======================================"
    echo

    local total=0
    local passed=0
    local failed=0

    for result in "${RESULTS[@]}"; do
        total=$((total + 1))
        local target item status
        IFS='|' read -r target item status <<< "$result"

        if [[ "$status" == "ok" ]]; then
            passed=$((passed + 1))
            log_success "[$target] $item: $INSTALLER_CMD"
        else
            failed=$((failed + 1))
            log_error "[$target] $item: $INSTALLER_CMD FAILED"
        fi
    done

    echo
    echo "Total: $total  Passed: $passed  Failed: $failed"

    if [[ ${#SYNC_WARNINGS[@]} -gt 0 ]]; then
        echo
        echo "Warnings:"
        local w
        for w in "${SYNC_WARNINGS[@]}"; do
            log_warn "$w"
        done
    fi

    if [[ $failed -eq 0 ]]; then
        log_success "All operations completed successfully!"
    else
        log_error "$failed operation(s) failed"
    fi
}

# Show usage
usage() {
    cat << 'EOF'
Usage: dotfiles <command> [options]

Commands:
  init                 Guided per-host setup: write the config file, then pull
  pull                 Fetch, then install if new, upgrade if exists; stops early if nothing changed
  sync                 Run 'add' to review local edits, then 'pull'; needs a terminal
  pull --remote HOST...  Send this machine's committed repos to HOST over ssh and pull there
  init --remote HOST...  Send them, then run 'dotfiles init' there instead of pull (first-time setup)
  uninstall            Uninstall all configs
  status               Show repos, version, host, last sync, pending packages, app state
                       and local edits (read-only)
  versions             List tagged versions
  checkout REF         Switch to a tag or commit and deploy it; this machine stays there
                       until you run 'dotfiles checkout main'
  add                  Review local edits one by one and stage the ones you accept in the
                       repo; never commits or pushes
  verify               Verify all installations
  help                 Show this help message

Profile options:
  --profile NAME       Use a specific profile (default: complete)
                       Profiles are defined in profiles/<name>.yaml

Hosts dir options:
  --hosts-dir PATH     dotfiles-hosts checkout (default: env DOTFILES_HOSTS_DIR)
                       Profiles are looked up there first, then in profiles/
  --hostname NAME      Host directory hosts/NAME/ to apply (default: hostname -s)

Init options:
  --hosts-dir URL|PATH|none  Hosts repo: a git URL (cloned to
                       ~/.local/share/dotfiles/dotfiles-hosts), a path, or none
  --hostname NAME      Host directory hosts/NAME/ to apply
  --profile NAME       Profile, when no hosts/NAME/host.yaml selects one
  --update-check on|off  Check for updates from new terminals (default: on)
  --interval <n>m|h|d  Update check interval (default: 4h)
  --yes                Accept defaults and flags without prompting
  --no-sync            Write the config only; do not run the first pull

Remote options:
  --remote HOST...     With pull or init: send this machine's committed repos to each
                       HOST (from here to the host), then run pull, or init, there.
                       The host's repos are replaced; it fetches nothing itself.
                       With init, --yes, --hostname, --profile, --update-check
                       and --interval are forwarded to the remote init (valid only with
                       init --remote)

Pull options:
  --no-fetch           Do not git pull the dotfiles and hosts dirs

Sync takes the layer and global options below, and --no-fetch; each is passed on
to 'add' and 'pull'.

Options (passed through to each app's installer):
  --dry-run            Show what would be done without making changes
  --no-backup          Skip creating backups
  --verbose            Verbose output
  --quiet              Minimal output
  --force              Force operation without prompts; pull redeploys even if nothing changed
  --skip-git-setup     Skip interactive git identity setup (for unattended runs)
  --shell-scripts-dir PATH  Set drop-in directory (default: ~/.bashrc.d)
  --log FILE           Log to file

Examples:
  dotfiles init                      # Set up this host (prompts), then pull
  dotfiles pull                      # Pull (uses profiles/complete.yaml)
  dotfiles pull --profile minimal    # Pull with the minimal profile
  dotfiles pull --dry-run            # Preview what would happen
  dotfiles sync                      # Review local edits with add, then pull
  dotfiles pull --remote user@host   # Send the repos to a host without git, pull there
  dotfiles init --remote user@host   # First-time setup of a host without git
  dotfiles status                    # Check all configs
  dotfiles versions                  # List tagged versions
  dotfiles checkout v1.2             # Pin this machine to v1.2 (a tag or commit)
  dotfiles checkout main             # Follow main again
  dotfiles add                       # Stage local edits you accept; you commit them
  dotfiles uninstall --no-backup     # Remove all configs

EOF
}

# Validate command
validate_command() {
    local cmd="$1"

    cmd=$(echo "$cmd" | tr -cd '[:alnum:]-')

    local valid_commands=(
        "init"
        "pull"
        "sync"
        "uninstall"
        "status"
        "verify"
        "versions"
        "checkout"
        "add"
        "check-updates"
        "help"
        "-h"
        "--help"
    )

    for valid_cmd in "${valid_commands[@]}"; do
        if [[ "$cmd" == "$valid_cmd" ]]; then
            echo "$cmd"
            return 0
        fi
    done

    if [[ "$cmd" == "push" ]]; then
        echo "Error: 'dotfiles push' is gone. Use 'dotfiles pull --remote HOST...' to update a host," >&2
        echo "or 'dotfiles init --remote HOST...' to set one up." >&2
        return 1
    fi

    echo "Error: Unknown command '$1'" >&2
    echo "" >&2
    echo "Valid commands: init, pull, sync, uninstall, status, verify, versions, checkout, add, help" >&2
    return 1
}

# Parse arguments
parse_args() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 1
    fi

    COMMAND=$(validate_command "$1") || exit 1
    shift

    # --remote turns pull and init into a send to other hosts: from here on the
    # command is "remote" (cmd_push), and PUSH_INIT says which command runs there
    if [[ "$COMMAND" == "pull" || "$COMMAND" == "init" ]]; then
        local arg
        for arg in "$@"; do
            if [[ "$arg" == "--remote" ]]; then
                [[ "$COMMAND" != "init" ]] || PUSH_INIT=true
                COMMAND="remote"
                break
            fi
        done
    fi

    case "$COMMAND" in
        pull) INSTALLER_CMD="deploy" ;;
        remote) INSTALLER_CMD="send" ;;
        *) INSTALLER_CMD="$COMMAND" ;;
    esac

    # init parses its own flags (lib/init.sh)
    if [[ "$COMMAND" == "init" ]]; then
        INIT_ARGS=("$@")
        return 0
    fi

    while [[ $# -gt 0 ]]; do
        # remote: --remote and the init flags it forwards to the remote init
        if [[ "$COMMAND" == "remote" ]]; then
            case $1 in
                --remote)
                    shift
                    continue
                    ;;
                --yes)
                    PUSH_INIT_ARGS+=("$1")
                    shift
                    continue
                    ;;
                --hostname|--profile|--update-check|--interval)
                    if [[ $# -lt 2 || "$2" == --* ]]; then
                        echo "Error: $1 requires a value" >&2
                        exit 1
                    fi
                    PUSH_INIT_ARGS+=("$1" "$2")
                    shift 2
                    continue
                    ;;
            esac
        fi
        case $1 in
            --profile)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --profile requires a profile name" >&2
                    exit 1
                fi
                PROFILE_ARG="$2"
                shift 2
                ;;
            --hosts-dir)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --hosts-dir requires a path argument" >&2
                    exit 1
                fi
                HOSTS_DIR="$2"
                shift 2
                ;;
            --hostname)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --hostname requires a name argument" >&2
                    exit 1
                fi
                if [[ -z "$2" || "$2" == */* || "$2" == . || "$2" == .. ]]; then
                    echo "Error: invalid --hostname '$2' (must be a plain name without '/')" >&2
                    exit 1
                fi
                HOSTNAME_ARG="$2"
                shift 2
                ;;
            --no-fetch)
                SYNC_NO_FETCH=true
                shift
                ;;
            --dry-run|--no-backup|--verbose|--quiet|--force)
                GLOBAL_FLAGS+=("$1")
                shift
                ;;
            --skip-git-setup)
                export GIT_SETUP_SKIP=true
                shift
                ;;
            --shell-scripts-dir)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --shell-scripts-dir requires a path argument" >&2
                    exit 1
                fi
                SHELL_SCRIPTS_DIR="$2"
                GLOBAL_FLAGS+=("$1" "$2")
                shift 2
                ;;
            --log)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --log requires a filename argument" >&2
                    exit 1
                fi
                GLOBAL_FLAGS+=("$1" "$2")
                shift 2
                ;;
            *)
                if [[ "$COMMAND" == "remote" && "$1" != -* ]]; then
                    PUSH_HOSTS+=("$1")
                    shift
                    continue
                fi
                if [[ "$COMMAND" == "checkout" && "$1" != -* && -z "$CHECKOUT_REF" ]]; then
                    CHECKOUT_REF="$1"
                    shift
                    continue
                fi
                echo "Error: Unknown option: $1" >&2
                usage
                exit 1
                ;;
        esac
    done

    if [[ "$COMMAND" == "checkout" && -z "$CHECKOUT_REF" ]]; then
        echo "Usage: dotfiles checkout <tag|commit|branch> [options]" >&2
        exit 1
    fi
    if [[ "$COMMAND" == "remote" && "$PUSH_INIT" != true && ${#PUSH_INIT_ARGS[@]} -gt 0 ]]; then
        echo "Error: ${PUSH_INIT_ARGS[0]} is only valid with init --remote" >&2
        echo "Usage: dotfiles init --remote [--yes] [--hostname NAME] [--profile NAME] [--update-check on|off] [--interval <n>m|h|d] HOST..." >&2
        exit 1
    fi
    # One hostname cannot name several hosts
    if [[ "$COMMAND" == "remote" && ${#PUSH_HOSTS[@]} -gt 1 ]]; then
        local a
        for a in ${PUSH_INIT_ARGS[@]+"${PUSH_INIT_ARGS[@]}"}; do
            if [[ "$a" == --hostname ]]; then
                echo "Error: --hostname is only valid with a single HOST" >&2
                echo "Usage: dotfiles init --remote [--yes] [--hostname NAME] [--profile NAME] [--update-check on|off] [--interval <n>m|h|d] HOST..." >&2
                exit 1
            fi
        done
    fi
}

# Fill in settings from flags, env, the config file and defaults.
# Precedence: flag > env DOTFILES_HOSTS_DIR (hosts dir only) > config > default.
# parse_args has set PROFILE_ARG/HOSTS_DIR/HOSTNAME_ARG only from flags.
resolve_settings() {
    local config_file="${DOTFILES_CONFIG:-$HOME/.config/dotfiles/config.yaml}"
    config_load "$config_file" || return 1

    # The running code is always the repo it was started from
    DOTFILES_REPO="$SCRIPT_DIR"

    if [[ -z "$HOSTS_DIR" ]]; then
        if [[ -n "${DOTFILES_HOSTS_DIR:-}" ]]; then
            HOSTS_DIR="$DOTFILES_HOSTS_DIR"
        elif [[ -n "$CFG_HOSTS_DIR" ]]; then
            HOSTS_DIR="$CFG_HOSTS_DIR"
        elif [[ -d "$DEFAULT_HOSTS_DIR" ]]; then
            HOSTS_DIR="$DEFAULT_HOSTS_DIR"
        fi
    fi
    [[ -n "$HOSTNAME_ARG" ]] || HOSTNAME_ARG="$CFG_HOSTNAME"
    [[ -n "$PROFILE_ARG" ]] || PROFILE_ARG="$CFG_PROFILE"

    UPDATE_CHECK="$CFG_UPDATE_CHECK"
    UPDATE_CHECK_SECONDS=$(config_interval_seconds "$CFG_UPDATE_CHECK_INTERVAL")
}

# True if the given flag was passed on to the installers
has_global_flag() {
    local flag
    for flag in "${GLOBAL_FLAGS[@]}"; do
        [[ "$flag" == "$1" ]] && return 0
    done
    return 1
}

# True if --dry-run was given
is_dry_run() {
    has_global_flag --dry-run
}

# EXIT trap: remove the work dir and run registered cleanup commands
cleanup() {
    local cmd
    for cmd in "${SYNC_CLEANUP[@]}"; do
        eval "$cmd" || true
    done
    [[ -n "$WORK_DIR" ]] && rm -rf "$WORK_DIR"
    if [[ "$SYNC_RECORD" == true ]]; then
        sync_record
    fi
    return 0
}

# End of a real (non-dry-run) pull: record the run, clear a stale report
sync_record() {
    sync_touch_last
    sync_clear_report
    return 0
}

# Point a pull at files with local edits
sync_warn_edits() {
    local n
    n=$(deployed_count_edits)
    [[ "$n" -gt 0 ]] || return 0
    log_warn "$n file(s) have local edits, run 'dotfiles add' to review them"
}

# Pull one repo. A failure (the network, say) is a warning, not a sync failure, and
# HEAD still deploys. A blocked pull (diverged, or local changes in the way) stops
# the run: deploying would hide that the repo is behind.
sync_pull_one() {
    local path="$1" reason rc=0
    reason=$(sync_pull_repo "$path") || rc=$?
    [[ $rc -ne 0 ]] || return 0
    if [[ $rc -eq 2 ]]; then
        log_error "$path: pull blocked ($reason); nothing was deployed"
        echo "Commit or set aside your changes there, then bring it up to date:" >&2
        echo "  cd $path && git pull --rebase" >&2
        echo "Push if the repo has commits of its own, then run: dotfiles pull" >&2
        exit 1
    fi
    SYNC_WARNINGS+=("$path: pull failed ($reason)")
    log_warn "$path: pull failed ($reason)"
}

# Describe a repo for status: git branch/sha/dirty, a pushed copy, or neither
# Usage: status_describe_repo PATH
status_describe_repo() {
    local path="$1" top branch sha dirty=""
    top=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)
    if [[ -n "$top" && "$(cd "$top" && pwd -P)" == "$(cd "$path" && pwd -P)" ]]; then
        branch=$(git -C "$path" symbolic-ref --short -q HEAD 2>/dev/null || echo "detached")
        sha=$(git -C "$path" rev-parse --short HEAD 2>/dev/null || echo "no commits")
        [[ -z "$(git --no-optional-locks -C "$path" status --porcelain 2>/dev/null)" ]] || dirty=", dirty"
        printf '%s  (git %s @ %s%s)' "$path" "$branch" "$sha" "$dirty"
    elif [[ -f "$path/PUSHED" ]]; then
        printf '%s  (pushed: %s)' "$path" "$(head -n1 "$path/PUSHED")"
    else
        printf '%s  (not a git checkout)' "$path"
    fi
}

# Seconds as "just now", "<n>m ago", "<n>h ago" or "<n>d ago" (rounded down)
status_age() {
    local s="$1"
    if (( s < 60 )); then printf 'just now'
    elif (( s < 3600 )); then printf '%dm ago' $((s / 60))
    elif (( s < 86400 )); then printf '%dh ago' $((s / 3600))
    else printf '%dd ago' $((s / 86400))
    fi
}

# dotfiles status: read-only summary. Takes no lock, never pulls, installs or
# writes state (SYNC_RECORD stays false). Resolution errors are printed and
# the command still exits 0.
cmd_status() {
    local config_file="${DOTFILES_CONFIG:-$HOME/.config/dotfiles/config.yaml}"
    # Not sync_state_dir: that creates the directory
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
    local ok=true

    resolve_settings || ok=false

    printf '%-17s%s\n' "dotfiles repo:" "$(status_describe_repo "$SCRIPT_DIR")"
    if versions_is_checkout "$SCRIPT_DIR"; then
        printf '%-17s%s\n' "version:" "$(versions_status_line "$SCRIPT_DIR")"
    fi
    if [[ -z "$HOSTS_DIR" ]]; then
        printf '%-17s%s\n' "hosts dir:" "none"
    elif [[ -d "$HOSTS_DIR" ]]; then
        HOSTS_DIR="$(cd "$HOSTS_DIR" && pwd)"
        printf '%-17s%s\n' "hosts dir:" "$(status_describe_repo "$HOSTS_DIR")"
    else
        printf '%-17s%s\n' "hosts dir:" "$HOSTS_DIR  (not found)"
        log_error "Hosts dir not found or not a directory: $HOSTS_DIR"
        ok=false
    fi
    repo_warn_dirty "$DOTFILES_REPO"
    [[ -z "$HOSTS_DIR" || ! -d "$HOSTS_DIR" ]] || repo_warn_dirty "$HOSTS_DIR"
    if [[ -f "$config_file" ]]; then
        printf '%-17s%s\n' "config:" "$config_file"
    else
        printf '%-17s%s\n' "config:" "$config_file (not found, using defaults)"
    fi

    # Host and profile
    local host host_note="(no host directory)" profile_note=""
    host="${HOSTNAME_ARG:-$(hosts_local_name)}"
    if [[ "$ok" == true ]]; then
        if load_packages_for_profile "$PROFILE_ARG" "$host"; then
            profile_note="   profile: $RESOLVED_PROFILE"
            [[ -z "$HOST_YAML" ]] || host_note="(hosts/$host/host.yaml)"
        else
            ok=false
        fi
    fi
    printf '%-17s%s\n' "host:" "$host  $host_note$profile_note"

    # Update check
    local check_line="off" last now
    if [[ "$UPDATE_CHECK" != "off" ]]; then
        check_line="on, every ${CFG_UPDATE_CHECK_INTERVAL:-4h}"
        if [[ -e "$state_dir/last-check" ]] && last=$(sync_mtime "$state_dir/last-check"); then
            now=$(date +%s)
            check_line+=" — last run $(status_age $(( now > last ? now - last : 0 )))"
        else
            check_line+=" — never run"
        fi
    fi
    printf '%-17s%s\n' "update check:" "$check_line"

    # Pending packages
    local pending=""
    if [[ -f "$state_dir/pending" ]]; then
        pending=$(grep -v '^$' "$state_dir/pending" | paste -sd, - | sed 's/,/, /g' || true)
    fi
    printf '%-17s%s\n' "pending:" "${pending:-none}"

    # Apps: installed state version against a fresh stage
    if [[ "$ok" == true ]]; then
        OVERLAY_HOST="$host"
        if ! prepare_overlays "status"; then
            log_error "Invalid overlay configuration"
            ok=false
        fi
    fi
    if [[ "$ok" == true ]]; then
        echo "apps:"
        local idx dir name app_name stage ver_fresh ver_state state_file state line
        local -a status_edits=()
        for idx in "${!PKG_NAMES[@]}"; do
            dir="${PKG_CONFIG_DIR[$idx]}"
            [[ -n "$dir" && -f "$APPS_DIR/$dir/config.yaml" ]] || continue
            name="${PKG_NAMES[$idx]}"
            yaml_load "$APPS_DIR/$dir/config.yaml"
            app_name=$(yaml_get app.name)
            [[ -n "$app_name" ]] || app_name=$(basename "$dir")
            stage="$STAGE_ROOT/apps/$dir"
            ver_fresh=""
            if overlay_stage_app "$APPS_DIR/$dir" "$stage" "$STRATEGIES_FILE" "${LAYER_ROOTS[@]}" 2>/dev/null; then
                ver_fresh=$(cat "$stage/version" 2>/dev/null || true)
            fi
            state_file=$(state_get_file "$app_name")
            if [[ ! -f "$state_file" ]]; then
                state="not installed"
            else
                ver_state=$(state_get_version "$app_name" 2>/dev/null || true)
                if [[ -n "$ver_fresh" && "$ver_state" == "$ver_fresh" && "$ver_state" != "incomplete" ]]; then
                    state="up to date"
                else
                    state="update available"
                fi
            fi
            printf '  %-9s %s\n' "$name" "$state"
            if [[ -n "$ver_fresh" ]]; then
                while IFS= read -r line; do
                    [[ -n "$line" ]] && status_edits+=("$line")
                done < <(deployed_app_edits "$app_name" "$stage")
            fi
        done
        if [[ ! -d "$STATE_DIR/deployed" ]]; then
            printf '%-17s%s\n' "local edits:" "not tracked yet (run 'dotfiles pull')"
        elif [[ ${#status_edits[@]} -eq 0 ]]; then
            printf '%-17s%s\n' "local edits:" "none"
        else
            echo "local edits:     ('dotfiles add' reviews them)"
            local kind src dest note
            for line in "${status_edits[@]}"; do
                IFS=$'\t' read -r kind src dest <<< "$line"
                case "$kind" in
                    conflict) note="  (the repo changed it too)" ;;
                    merge)    note="  (merged, keys the repo manages differ)" ;;
                    *)        note="" ;;
                esac
                printf '  %s%s\n' "$(add_tilde "$dest")" "$note"
            done
        fi
    fi
    return 0
}

# dotfiles pull --remote / init --remote HOST...: no local pull, no lock, no local state
cmd_push() {
    if [[ ${#PUSH_HOSTS[@]} -eq 0 ]]; then
        if [[ "$PUSH_INIT" == true ]]; then
            echo "Usage: dotfiles init --remote [--dry-run] [init flags] HOST..." >&2
        else
            echo "Usage: dotfiles pull --remote [--dry-run] [--force] HOST..." >&2
        fi
        exit 1
    fi
    push_validate_init_flags ${PUSH_INIT_ARGS[@]+"${PUSH_INIT_ARGS[@]}"} || exit 1
    local dry=false host failed=0
    is_dry_run && dry=true
    [[ "$PUSH_INIT" == true ]] || push_warn_behind "$DOTFILES_REPO" "$HOSTS_DIR"
    for host in "${PUSH_HOSTS[@]}"; do
        log_info "[$host] Sending"
        if push_host "$host" "$PUSH_INIT" "$dry" ${PUSH_INIT_ARGS[@]+"${PUSH_INIT_ARGS[@]}"}; then
            RESULTS+=("$host|remote|ok")
        else
            RESULTS+=("$host|remote|FAIL")
            failed=1
        fi
    done
    print_summary
    exit $failed
}

# dotfiles sync: add, then pull. Each is its own process, so each takes its
# own lock and settings. A dry run previews the pull; add has no dry run.
cmd_sync() {
    local -a layer=()
    [[ -z "$PROFILE_ARG" ]] || layer+=(--profile "$PROFILE_ARG")
    [[ -z "$HOSTS_DIR" ]] || layer+=(--hosts-dir "$HOSTS_DIR")
    [[ -z "$HOSTNAME_ARG" ]] || layer+=(--hostname "$HOSTNAME_ARG")
    local -a pull_args=(pull ${layer[@]+"${layer[@]}"} ${GLOBAL_FLAGS[@]+"${GLOBAL_FLAGS[@]}"})
    [[ "$SYNC_NO_FETCH" != true ]] || pull_args+=(--no-fetch)

    if is_dry_run; then
        echo "Skipping 'dotfiles add' in a dry run"
        exec "$SCRIPT_DIR/dotfiles" "${pull_args[@]}"
    fi
    if [[ ! -t 0 && "${DOTFILES_ADD_ASSUME_TTY:-}" != 1 ]]; then
        echo "dotfiles sync needs a terminal: it runs 'dotfiles add', which asks about each local edit" >&2
        exit 1
    fi
    "$SCRIPT_DIR/dotfiles" add ${layer[@]+"${layer[@]}"} || exit $?
    exec "$SCRIPT_DIR/dotfiles" "${pull_args[@]}"
}

# Warn when a repo is behind its upstream: what is sent is what is committed
# here, so the host would get an old version.
# Usage: push_warn_behind REPO...
push_warn_behind() {
    local repo behind
    for repo in "$@"; do
        [[ -n "$repo" ]] || continue
        behind=$(git -C "$repo" rev-list --count 'HEAD..@{u}' 2>/dev/null) || continue
        if [[ "${behind:-0}" -gt 0 ]]; then
            log_warn "$repo is $behind commit(s) behind its upstream; the host gets what is here (run 'dotfiles pull' first for the latest)"
        fi
    done
}

# Main
main() {
    parse_args "$@"

    # Initialize logging
    log_init "$@"

    WORK_DIR=$(mktemp -d)
    trap cleanup EXIT

    # init: its own settings flow (no resolve_settings); exits with its code
    [[ "$COMMAND" != "init" ]] || init_main ${INIT_ARGS[@]+"${INIT_ARGS[@]}"}

    # Handle help
    if [[ "$COMMAND" == "help" || "$COMMAND" == "--help" || "$COMMAND" == "-h" ]]; then
        usage
        exit 0
    fi

    if [[ "$COMMAND" == "status" ]]; then
        cmd_status
        exit 0
    fi

    # Before settings: these two need only the repo (checkout's pull reads the config)
    [[ "$COMMAND" != "versions" ]] || cmd_versions
    [[ "$COMMAND" != "checkout" ]] || cmd_checkout
    [[ "$COMMAND" != "sync" ]] || cmd_sync

    resolve_settings || exit 1

    # The login drop-in's background check: fetch, report, nothing else. A held
    # lock (a pull running, or another check) means skip quietly.
    if [[ "$COMMAND" == "check-updates" ]]; then
        sync_lock || exit 0
        sync_check_updates
        exit 0
    fi

    if [[ "$COMMAND" == "pull" ]] && ! is_dry_run; then
        if ! sync_lock; then
            echo "dotfiles: pull already running" >&2
            exit 1
        fi
        # From here on the EXIT trap records the run, however it ends
        SYNC_RECORD=true
    fi

    # Validate hosts dir before any changes
    if [[ -n "$HOSTS_DIR" ]]; then
        if [[ ! -d "$HOSTS_DIR" ]]; then
            log_error "Hosts dir not found or not a directory: $HOSTS_DIR"
            exit 1
        fi
        HOSTS_DIR="$(cd "$HOSTS_DIR" && pwd)"
    fi

    [[ "$COMMAND" != "remote" ]] || cmd_push
    [[ "$COMMAND" != "add" ]] || cmd_add

    if [[ "$COMMAND" == "pull" ]]; then
        if [[ "$SYNC_NO_FETCH" != true ]] && ! is_dry_run; then
            sync_pull_one "$DOTFILES_REPO"
            [[ -z "$HOSTS_DIR" ]] || sync_pull_one "$HOSTS_DIR"
        fi
        is_dry_run || sync_self_install "$DOTFILES_REPO" "$SHELL_SCRIPTS_DIR"
        versions_warn_pinned "$DOTFILES_REPO"
    fi

    # Nothing changed since the last complete pull: nothing to do. Worked out
    # after the pull, and before deploying so a change made meanwhile is seen.
    local fingerprint=""
    if [[ "$COMMAND" == "pull" ]]; then
        repo_warn_dirty "$DOTFILES_REPO"
        [[ -z "$HOSTS_DIR" ]] || repo_warn_dirty "$HOSTS_DIR"
    fi
    if [[ "$COMMAND" == "pull" ]] && ! is_dry_run; then
        fingerprint=$(sync_fingerprint) || fingerprint=""
        if ! has_global_flag --force && sync_is_complete "$fingerprint"; then
            log_success "Already up to date (use --force to redeploy)"
            sync_warn_edits
            exit 0
        fi
        sync_forget_complete
    elif [[ "$COMMAND" == "uninstall" ]] && ! is_dry_run; then
        sync_forget_complete
    fi

    run_all "$PROFILE_ARG"

    # Pending packages are only worked out by pull
    if [[ "$COMMAND" == "pull" ]] && ! is_dry_run; then
        sync_write_pending ${PENDING[@]+"${PENDING[@]}"}
        sync_record_complete "$fingerprint"
    fi

    print_summary
    [[ "$COMMAND" != "pull" ]] || sync_warn_edits

    exit $EXIT_CODE
}

main "$@"
